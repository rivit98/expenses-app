{
    "name": "Visual Studio Code - NodeJS dev env",

    // Keep the major in step with frontend/.node-version and the CI workflow.
    "image": "node:24",

    "shutdownAction": "stopContainer",

    "postCreateCommand": "npm ci",

    "forwardPorts": [5173],

    "customizations": {
        "vscode": {
            "extensions": [
                "biomejs.biome",
                "christian-kohler.path-intellisense",
                "oderwat.indent-rainbow",
                "fill-labs.dependi"
            ]
        }
    },

    "remoteUser": "node"
}
