{
    "name": "Visual Studio Code - NodeJS dev env",

    // Must match .node-version. Devcontainer cannot read that file, so this is the
    // one place the version is duplicated; CI and the prod image both derive it.
    "image": "node:24.19.0",

    "shutdownAction": "stopContainer",

    "postCreateCommand": "npm ci",

    "forwardPorts": [5173],

    "customizations": {
        "vscode": {
            "extensions": [
                "biomejs.biome",
                "christian-kohler.path-intellisense",
                "oderwat.indent-rainbow",
                "fill-labs.dependi"
            ]
        }
    },

    "remoteUser": "node"
}
